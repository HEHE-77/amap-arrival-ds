{
  "$description": "高德到达页设计系统 · Design tokens（三层：primitive → semantic → component）。$figma 标记该值在 Figma 中已绑定为变量/样式；未标记的是从 Header (849:2976) 硬编码值中提取、建议回填到 Figma 的变量。",

  "primitive": {
    "color": {
      "gray-900": { "$value": "#191919", "$type": "color" },
      "gray-600": { "$value": "#5A5A5A", "$type": "color" },
      "gray-50":  { "$value": "#FBFBFB", "$type": "color" },
      "green-600": { "$value": "#00A27F", "$type": "color" }
    },
    "font": {
      "family-base": { "$value": "'PingFang SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Microsoft YaHei', sans-serif", "$type": "fontFamily" },
      "weight-regular":  { "$value": 400, "$type": "fontWeight" },
      "weight-medium":   { "$value": 500, "$type": "fontWeight" },
      "weight-semibold": { "$value": 600, "$type": "fontWeight" },
      "size-12": { "$value": "12px", "$type": "dimension" },
      "size-24": { "$value": "24px", "$type": "dimension" }
    },
    "space": {
      "2": { "$value": "2px", "$type": "dimension" },
      "6": { "$value": "6px", "$type": "dimension" },
      "8": { "$value": "8px", "$type": "dimension" }
    },
    "radius": {
      "16": { "$value": "16px", "$type": "dimension" }
    }
  },

  "semantic": {
    "color": {
      "text-primary":   { "$value": "{primitive.color.gray-900}", "$figma": "正文字体" },
      "text-secondary": { "$value": "{primitive.color.gray-600}" },
      "text-eco":       { "$value": "{primitive.color.green-600}", "$description": "绿色能量 / 低碳出行相关正向反馈" },
      "surface-page":   { "$value": "{primitive.color.gray-50}" }
    },
    "typography": {
      "title-l": {
        "$value": { "fontFamily": "{primitive.font.family-base}", "fontWeight": "{primitive.font.weight-semibold}", "fontSize": "{primitive.font.size-24}", "lineHeight": "22.8px" },
        "$type": "typography"
      },
      "body-s": {
        "$value": { "fontFamily": "{primitive.font.family-base}", "fontWeight": "{primitive.font.weight-regular}", "fontSize": "{primitive.font.size-12}", "lineHeight": "17px" },
        "$type": "typography",
        "$figma": "卡片正文"
      },
      "body-s-strong": {
        "$value": { "fontFamily": "{primitive.font.family-base}", "fontWeight": "{primitive.font.weight-medium}", "fontSize": "{primitive.font.size-12}", "lineHeight": "16.8px" },
        "$type": "typography"
      }
    }
  },

  "component": {
    "header": {
      "width":            { "$value": "366px" },
      "height":           { "$value": "72px" },
      "radius-end":       { "$value": "{primitive.radius.16}", "$description": "仅右上、右下圆角" },
      "fade-color":       { "$value": "{semantic.color.surface-page}" },
      "fade-stop":        { "$value": "64.247%", "$description": "实色区占比，之后渐隐露出地图缩略图" },
      "gap-title-meta":   { "$value": "{primitive.space.8}" },
      "gap-meta-rows":    { "$value": "{primitive.space.6}" },
      "gap-actions":      { "$value": "{primitive.space.8}" },
      "gap-icon-label":   { "$value": "{primitive.space.2}" },
      "thumb-size":       { "$value": "216px" },
      "thumb-offset-end": { "$value": "-4px" },
      "thumb-offset-top": { "$value": "-85px" },
      "eco-icon-w":       { "$value": "18px" },
      "eco-icon-h":       { "$value": "17px" },
      "chevron-size":     { "$value": "17px" }
    }
  }
}
